{
  "rewrites": [
    { "source": "/admin", "destination": "https://lt4bgzvqs5jwu.kimi.pro/admin" },
    { "source": "/admin/:path*", "destination": "https://lt4bgzvqs5jwu.kimi.pro/admin/:path*" },
    { "source": "/api/:path*", "destination": "https://lt4bgzvqs5jwu.kimi.pro/api/:path*" },
    { "source": "/assets/:path*", "destination": "https://lt4bgzvqs5jwu.kimi.pro/assets/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/(img|logo|favicon)(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
